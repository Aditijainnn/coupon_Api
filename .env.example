# Copy this file to .env and fill in your own values:
#   Windows PowerShell:   Copy-Item .env.example .env
#   macOS / Linux:        cp .env.example .env
# .env is listed in .gitignore, so your real connection string is never committed.

# Port the API listens on.
PORT=3000

# MongoDB connection string. Put the database name (coupon_api) right after the host, before any "?".
#
# MongoDB Atlas (replace <username>, <password> and <cluster-host>):
#   MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/coupon_api?retryWrites=true&w=majority
#
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/coupon_api
